{
  "name": "workspace-jumper",
  "displayName": "WorkSnap",
  "description": "Privacy-focused workspace manager - encrypted storage, no network access",
  "version": "1.0.0",
  "publisher": "omara",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "workspace",
    "privacy",
    "encrypted",
    "secure",
    "productivity"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "workspace-jumper.jump",
        "title": "Jump to Workspace",
        "category": "WorkSnap"
      },
      {
        "command": "workspace-jumper.editWorkspace",
        "title": "Edit Workspace (Nickname/Sensitive)",
        "category": "WorkSnap"
      },
      {
        "command": "workspace-jumper.removeWorkspace",
        "title": "Remove Workspace from History",
        "category": "WorkSnap"
      },
      {
        "command": "workspace-jumper.clearHistory",
        "title": "Clear All Workspace History",
        "category": "WorkSnap"
      },
      {
        "command": "workspace-jumper.toggleSensitive",
        "title": "Toggle Sensitive Flag on Current Workspace",
        "category": "WorkSnap"
      }
    ],
    "configuration": {
      "title": "WorkSnap",
      "properties": {
        "worksnap.autoResumeEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically resume the last workspace when VS Code opens without a folder"
        },
        "worksnap.maxHistory": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum number of workspaces to keep in history"
        }
      }
    },
    "menus": {
      "statusBar/left": [
        {
          "command": "workspace-jumper.jump",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "workspace-jumper.jump",
          "when": "true"
        },
        {
          "command": "workspace-jumper.editWorkspace",
          "when": "true"
        },
        {
          "command": "workspace-jumper.removeWorkspace",
          "when": "true"
        },
        {
          "command": "workspace-jumper.clearHistory",
          "when": "true"
        },
        {
          "command": "workspace-jumper.toggleSensitive",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "keybindings": [
      {
        "command": "workspace-jumper.jump",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w"
      },
      {
        "command": "workspace-jumper.toggleSensitive",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "pretest": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "typescript": "^5.9.3"
  }
}
