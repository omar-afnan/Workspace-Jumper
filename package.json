{
  "name": "workspace-jumper",
  "displayName": "WorkSnap",
  "description": "Resume and jump between VS Code workspaces",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:workspace-jumper.jump"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "workspace-jumper.jump",
        "title": "Jump to Workspace"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "pretest": "npm run compile",
    "package": "vsce package",
    "watch:esbuild": "npm run watch"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "esbuild": "^0.27.1",
    "typescript": "^5.9.3"
  }
}
