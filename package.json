{
  "name": "workspace-jumper",
  "displayName": "WorkSnap  Workspace Manager",
  "description": "🚀 Quick workspace switcher with encrypted history, instant navigation, and privacy-first design. Jump between projects with one click!",
  "version": "1.1.5",
  "publisher": "omara",
  "repository": {
    "type": "git",
    "url": "https://github.com/omar-afnan/workspace-jumper"
  },
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "workspace",
    "workspace manager",
    "workspace switcher",
    "privacy",
    "encrypted",
    "secure",
    "productivity",
    "navigation",
    "project manager",
    "quick switch"
  ],
  "activationEvents": [
    "onView:worksnap.sidebarView",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "workspace-jumper.jump",
        "title": "Jump to Workspace",
        "category": "WorkSnap"
      },
      {
        "command": "workspace-jumper.editWorkspace",
        "title": "Edit Workspace (Nickname/Sensitive)",
        "category": "WorkSnap"
      },
      {
        "command": "workspace-jumper.removeWorkspace",
        "title": "Remove Workspace from History",
        "category": "WorkSnap"
      },
      {
        "command": "workspace-jumper.clearHistory",
        "title": "Clear All Workspace History",
        "category": "WorkSnap"
      },
      {
        "command": "workspace-jumper.toggleSensitive",
        "title": "Toggle Sensitive Flag on Current Workspace",
        "category": "WorkSnap"
      },
      {
        "command": "worksnap.openDashboard",
        "title": "WorkSnap: Open Dashboard",
        "category": "WorkSnap"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "worksnap",
          "title": "WorkSnap",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "worksnap": [
        {
          "id": "worksnap.sidebarView",
          "name": "WorkSnap Dashboard",
          "type": "webview",
          "icon": "media/icon.svg",
          "contextualTitle": "WorkSnap"
        }
      ]
    },
    "configuration": {
      "title": "WorkSnap",
      "properties": {
        "worksnap.autoResumeEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically resume the last workspace when VS Code opens without a folder"
        },
        "worksnap.maxHistory": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum number of workspaces to keep in history"
        }
      }
    },
    "menus": {
      "statusBar/left": [
        {
          "command": "workspace-jumper.jump",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "workspace-jumper.jump",
          "when": "true"
        },
        {
          "command": "workspace-jumper.editWorkspace",
          "when": "true"
        },
        {
          "command": "workspace-jumper.removeWorkspace",
          "when": "true"
        },
        {
          "command": "workspace-jumper.clearHistory",
          "when": "true"
        },
        {
          "command": "workspace-jumper.toggleSensitive",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "keybindings": [
      {
        "command": "workspace-jumper.jump",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w"
      },
      {
        "command": "workspace-jumper.toggleSensitive",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "watch:tsc": "tsc -w -p tsconfig.json",
    "watch:esbuild": "node esbuild.js --watch",
    "pretest": "npm run compile",
    "verify": "node scripts/verify-package.js",
    "package": "npm run verify && vsce package",
    "publish": "npm run verify && vsce publish",
    "icon:svg2png": "inkscape media/icon.svg --export-type=png --export-filename=media/icon.png --export-width=128 --export-height=128",
    "icon:svg2png:magick": "magick convert media/icon.svg -resize 128x128 media/icon.png",
    "icon:node": "node scripts/convert-icon.js",
    "dev": "npm run watch",
    "vscode:prepublish": "npm run compile"
  },
  "icon": "media/icon.png",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "esbuild": "^0.27.2",
    "sharp": "^0.32.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.44"
  }
}
