{
  "name": "workspace-jumper",
  "displayName": "WorkSnap",
  "description": "Resume and jump between VS Code workspaces",
  "version": "0.0.3",
  "publisher": "Syed Muhammad Omar Afnan",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:workspace-jumper.jump",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "workspace-jumper.jump",
        "title": "Jump to Workspace"
      }
    ],
    "menus": {
      "statusBar/left": [
        {
          "command": "workspace-jumper.jump",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "workspace-jumper.jump",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "pretest": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "typescript": "^5.9.3"
  }
}
