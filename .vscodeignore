.vscode/**
.vscode-test/**
.github/**
.claude/**
scripts/**
out/**
# `npm run compile` (tsc) also emits into dist/ for the unit tests. Only the
# esbuild bundle is shipped; utils.js is already inlined into it.
dist/test/**
dist/utils.js
node_modules/**
# Only the two files the webview actually loads. Un-ignoring the whole codicons
# package pulled in every source SVG and its CI config.
!node_modules/@vscode/codicons/dist/codicon.css
!node_modules/@vscode/codicons/dist/codicon.ttf
src/**
# Note: `!media/**` takes precedence over any later media/ exclusion, so
# screenshots under media/screenshots/ do ship inside the .vsix. Keep them
# small (a few hundred KB total) or move them out of media/ if that changes.
!media/**
.gitignore
.yarnrc
esbuild.js
vsc-extension-quickstart.md
**/tsconfig.json
**/eslint.config.mjs
**/*.map
**/*.ts
**/.vscode-test.*
